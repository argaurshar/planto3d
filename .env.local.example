# Copy this file to `.env.local` and fill in your key.
#
# kie.ai API key with access to the Nano Banana 2 model (`nano-banana-2`).
# Get / manage your key at https://kie.ai/api-key
#
# This key is used ONLY server-side (in app/api/* route handlers and
# lib/kie.ts); it is never exposed to the browser.
KIE_API_KEY=

# Optional overrides:
# KIE_IMAGE_MODEL=nano-banana-2
# KIE_IMAGE_RESOLUTION=1K        # one of: 1K, 2K, 4K
# KIE_CHAT_MODEL=gemini-3-flash     # vision LLM that writes the interior prompt + verifies renders
# KIE_DETECT_MODEL=gemini-3-pro     # stronger model for room object detection (blockout)
# KIE_KONTEXT_MODEL=flux-kontext-max # "Edit" render engine (FLUX Kontext)
# KIE_REFERENCE_MODEL=nano-banana-pro # "Reference" render engine (clay + depth map in, photo out)
# KIE_REFERENCE_RESOLUTION=2K         # one of: 1K, 2K, 4K
# KIE_STRUCTURE_MODEL=qwen/image-to-image # "Structure-locked" engine (img2img with a denoise strength)
# KIE_STRUCTURE_GUIDANCE=3
# (gemini-2.5-flash / -pro were retired by Google — see https://ai.google.dev/gemini-api/docs/deprecations)
